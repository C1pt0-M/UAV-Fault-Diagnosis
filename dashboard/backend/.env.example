# Flask
FLASK_DEBUG=False
APP_ENV=production
API_PREFIX=/api
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
CORS_ORIGINS=https://example.com

# SQLite
DB_TYPE=sqlite
DB_PATH=runtime/dashboard.db

# Runtime
RUNTIME_DIR=runtime
REPORTS_DIR=runtime/reports
TASK_MAX_WORKERS=2
MAX_CONTENT_LENGTH=134217728
ALLOW_AUTO_BOOTSTRAP_ADMIN=False
ENABLE_SETUP_API=False
ENABLE_PUBLIC_REGISTER=False
ENABLE_TELEMETRY=True
ENABLE_BLIND_TEST=False
TELEMETRY_ALLOWED_BACKENDS=replay
ENABLE_AI=False
EXPOSE_SERVER_PATHS=False

# Bridge (ML / Telemetry)
ML_PYTHON_BIN=
TELEMETRY_PYTHON_BIN=
PX4_ROOT=~/PX4-Autopilot
FAULT_DATASET_ROOT=
ULG_PREPARE_SCRIPT=
MODEL_ROOT=models
OFFLINE_NORM_STATS=models/transfer3_cnnlstm_normalproto/norm_stats.json
DEFAULT_OFFLINE_MODEL=transfer3_cnnlstm_normalproto
DEFAULT_ONLINE_MODEL=online_detector_cnn1d_rfly
ONLINE_MODEL_PRIORITY=online_detector_cnn1d_rfly,online_detector_CNN,online_detector_final

# AI
AI_ENABLE_KNOWLEDGE_BASE=False
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V3.2
AI_KNOWLEDGE_DIR=knowledge_base
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_RAG_MODE=hybrid
