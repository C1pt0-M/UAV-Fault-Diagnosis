* text=auto eol=lf

# Keep generated and binary assets out of text normalization.
*.7z binary
*.bin binary
*.db binary
*.docx binary
*.gz binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.pdf binary
*.png binary
*.ppt binary
*.pptx binary
*.pt binary
*.sqlite binary
*.tar binary
*.tar.gz binary
*.zip binary

# Structured source and configuration remain diffable text.
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.vue text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Frozen protocol hashes refer to original bytes, including line endings.
artifacts/normal_adaptation_audit_20261029/normal_adaptation_protocol_v1.json -text
artifacts/normal_adaptation_audit_20261029/real_case_roles_v1.csv -text

