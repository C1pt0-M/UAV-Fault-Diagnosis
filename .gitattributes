* text=auto eol=lf

# Keep generated and binary assets out of text normalization.
*.7z binary
*.bin binary
*.db binary
*.docx binary
*.gz binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.pdf binary
*.png binary
*.ppt binary
*.pptx binary
*.pt binary
*.sqlite binary
*.tar binary
*.tar.gz binary
*.zip binary

# Structured source and configuration remain diffable text.
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.vue text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
