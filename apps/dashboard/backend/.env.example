# Flask
FLASK_DEBUG=False
# development=本地开发/演示（可直接启动）；production=比赛/正式部署（必须配置强密钥，见下）
APP_ENV=development
API_PREFIX=/api
# 生产环境（APP_ENV=production）必须把下面两个值替换为至少 32 字符的随机串，且两者不能相同，否则启动会失败。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
CORS_ORIGINS=https://example.com

# SQLite
DB_TYPE=sqlite
DB_PATH=runtime/dashboard.db
# WAL 提升并发读写；WAL 下 SYNCHRONOUS 用 NORMAL 已足够安全。
SQLITE_ENABLE_WAL=True
SQLITE_SYNCHRONOUS=NORMAL

# Runtime
RUNTIME_DIR=runtime
REPORTS_DIR=runtime/reports
TASK_MAX_WORKERS=2
MAX_CONTENT_LENGTH=134217728
ALLOW_AUTO_BOOTSTRAP_ADMIN=False
# 仅在 ALLOW_AUTO_BOOTSTRAP_ADMIN=True 时生效：首次启动自动创建的管理员账号。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_REAL_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DEPARTMENT=平台组
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 首次启动时保持 True，管理员初始化完成后改为 False 并重启后端。
ENABLE_SETUP_API=True
ENABLE_PUBLIC_REGISTER=False
ENABLE_TELEMETRY=True
ENABLE_BLIND_TEST=False
TELEMETRY_ALLOWED_BACKENDS=replay,rfly
ENABLE_AI=False
EXPOSE_SERVER_PATHS=False

# Bridge (ML / Telemetry)
ML_PYTHON_BIN=
TELEMETRY_PYTHON_BIN=
RFLY_PYTHON_BIN=D:\PX4PSP\Python38\python.exe
PX4_ROOT=~/PX4-Autopilot
# managed=由后端拉起 SITL；attach=连接已在运行的实例。
PX4_LAUNCH_MODE=managed
PX4_SYS_AUTOSTART=4001
PX4_SIM_TARGET=gz_x500_lawn
PX4_READY_HOST=127.0.0.1
RFLY_PX4MAVCTRL_PATH=D:\PX4PSP\RflySimAPIs\RflySimSDK\ctrl\PX4MavCtrlV4.py
RFLY_BRIDGE_MODE=attach
RFLY_SIM_MAP=LowGPU
RFLY_AUTO_START_SIM=true
RFLY_POWERSHELL_BIN=pwsh
RFLY_SIM_START_SCRIPT=scripts/start_rflysim_sitl_qgc.ps1
RFLY_SIM_STOP_SCRIPT=scripts/stop_rflysim_sitl.ps1
RFLY_SIM_START_TIMEOUT_S=180.0
RFLY_SIM_STOP_TIMEOUT_S=45.0
RFLY_SIM_ATTACH_WAIT_S=2.0
RFLY_SITL_FRAME=iris
RFLY_QGC_UDP_PORT=14600
RFLY_DASHBOARD_PYMAV_UDP_PORT=14031
RFLY_BUAA_AUTOTEST_DIR=D:\BuaaAutoTestPlatForm\AutoTestAPI
RFLY_BUAA_UNIQUE_INDEX=1419000188
RFLY_BUAA_STARTUP_WAIT_S=25.0
RFLY_BUAA_READY_TIMEOUT_S=90.0
RFLY_BUAA_AUTO_CONTROL=false
RFLY_FORWARD_HOST=127.0.0.1
RFLY_FORWARD_PORT=15550
RFLY_INFERENCE_LOCATION=center
RFLY_MEC_LISTEN_HOST=127.0.0.1
RFLY_MEC_LISTEN_PORT=15552
RFLY_MEC_FORWARD_HOST=127.0.0.1
RFLY_MEC_FORWARD_PORT=15550
RFLY_MEC_SCRIPT=packages/uav_fault/uav_fault/telemetry/mec_service.py
RFLY_MEC_INFERENCE_STRIDE=5
RFLY_MEC_STARTUP_WAIT_S=0.2
RFLY_EMIT_RATE_HZ=50
RFLY_RPM_SCALE=10000.0
RFLY_TEST_ID=1
RFLY_UDP_PORT=20100
RFLY_UDP_MODE=2
RFLY_MAV_IP=127.0.0.1
RFLY_PYMAV_ADDRESS=udpin:0.0.0.0:14031
RFLY_ENABLE_PYMAV=true
RFLY_RECEIVER_TIMEOUT_S=60.0

# Telemetry（在线监测遥测接收）
TELEMETRY_MAVSDK_ADDRESS=udpin://0.0.0.0:14550
TELEMETRY_PYMAV_ADDRESS=udpin:0.0.0.0:14030
TELEMETRY_FORWARD_HOST=127.0.0.1
TELEMETRY_ENABLE_PYMAV=True
TELEMETRY_START_FLIGHT_CONTROLLER=True

FAULT_DATASET_ROOT=
ULG_PREPARE_SCRIPT=
MODEL_ROOT=assets/models
OFFLINE_NORM_STATS=assets/models/transfer3_cnnlstm_normalproto/norm_stats.json
DEFAULT_OFFLINE_MODEL=transfer3_cnnlstm_normalproto
DEFAULT_ONLINE_MODEL=online_detector_kg_mstca_rfly
ONLINE_INFERENCE_STRIDE=5
ONLINE_MODEL_PRIORITY=online_detector_kg_mstca_rfly,online_detector_mstca_rfly,online_detector_cnn1d_rfly

# AI
AI_PROVIDER=openai_compatible
AI_ENABLE_KNOWLEDGE_BASE=False
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V3.2
AI_KNOWLEDGE_DIR=knowledge_base
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# RAG_MODE 可以选择 bm25、hybrid 或 semantic；hybrid/semantic 均需要显式配置独立的 Embedding 地址、密钥和模型。
AI_RAG_MODE=bm25
AI_HTTP_TIMEOUT=120
