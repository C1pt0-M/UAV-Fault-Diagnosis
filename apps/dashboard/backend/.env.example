# Flask
FLASK_DEBUG=False
APP_ENV=production
API_PREFIX=/api
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
CORS_ORIGINS=https://example.com

# SQLite
DB_TYPE=sqlite
DB_PATH=runtime/dashboard.db

# Runtime
RUNTIME_DIR=runtime
REPORTS_DIR=runtime/reports
TASK_MAX_WORKERS=2
MAX_CONTENT_LENGTH=134217728
ALLOW_AUTO_BOOTSTRAP_ADMIN=False
ENABLE_SETUP_API=False
ENABLE_PUBLIC_REGISTER=True
ENABLE_TELEMETRY=True
ENABLE_BLIND_TEST=False
TELEMETRY_ALLOWED_BACKENDS=replay,rfly
ENABLE_AI=False
EXPOSE_SERVER_PATHS=False

# Bridge (ML / Telemetry)
ML_PYTHON_BIN=
TELEMETRY_PYTHON_BIN=D:\PX4PSP\Python38\python.exe
PX4_ROOT=~/PX4-Autopilot
RFLY_PX4MAVCTRL_PATH=D:\PX4PSP\RflySimAPIs\5.RflySimFlyCtrl\1.BasicExps\e10-FixedWingCtrl\code_10\HITL\PX4MavCtrlV4.py
RFLY_FORWARD_HOST=127.0.0.1
RFLY_FORWARD_PORT=15550
RFLY_EMIT_RATE_HZ=50
RFLY_RPM_SCALE=10000.0
RFLY_TEST_ID=1
RFLY_UDP_PORT=20100
RFLY_UDP_MODE=2
RFLY_MAV_IP=127.0.0.1
RFLY_PYMAV_ADDRESS=udpin:0.0.0.0:14030
RFLY_ENABLE_PYMAV=false
RFLY_RECEIVER_TIMEOUT_S=60.0
FAULT_DATASET_ROOT=
ULG_PREPARE_SCRIPT=
MODEL_ROOT=assets/models
OFFLINE_NORM_STATS=assets/models/transfer3_cnnlstm_normalproto/norm_stats.json
DEFAULT_OFFLINE_MODEL=transfer3_cnnlstm_normalproto
DEFAULT_ONLINE_MODEL=online_detector_kg_mstca_rfly
ONLINE_MODEL_PRIORITY=online_detector_kg_mstca_rfly,online_detector_mstca_rfly,online_detector_cnn1d_rfly

# AI
AI_ENABLE_KNOWLEDGE_BASE=False
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V3.2
AI_KNOWLEDGE_DIR=knowledge_base
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# RAG_MODE可以选择bm25或hybrid，若选择hybrid，需要配置AI_EMBEDDING_MODEL，会先使用bm25检索相关文档，再使用embedding模型进行重排序，提升相关性
AI_RAG_MODE=bm25
AI_HTTP_TIMEOUT=120
