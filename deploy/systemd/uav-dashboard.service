[Unit]
Description=Data-driven UAV Fault Diagnosis Dashboard Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/uav-dashboard/apps/dashboard/backend
EnvironmentFile=/etc/uav-dashboard.env
ExecStart=/srv/uav-dashboard/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8000 --chdir /srv/uav-dashboard/apps/dashboard/backend wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
